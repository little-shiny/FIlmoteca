<?xml version="1.0" encoding="utf-8"?>
<!--
    Define las rutas de almacenamiento que FileProvider puede exponer
    mediante URIs seguras

    external-files-path → getExternalFilesDir()
        Pictures/  →  directorio temporal de imágenes capturadas
        Movies/    →  directorio temporal de vídeos capturados (uso futuro)
-->
<paths>
    <external-files-path name="pictures" path="Pictures/" />
    <external-files-path name="movies"   path="Movies/" />
</paths>